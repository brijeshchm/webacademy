APP_NAME="Corporate Academy API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com/api
# CORS: the React frontend origin allowed to call this API.
# REQUIRED in production — without this, all browser requests will be blocked (fail-closed).
FRONTEND_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# ─── Database (MySQL on cPanel) ────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Use the Replit AI Integrations proxy (or set to your own OpenAI API key)
OPENAI_API_KEY=your_openai_api_key_here
# Optional: custom base URL (e.g. Replit proxy). Leave blank to use OpenAI directly.
OPENAI_BASE_URL=https://api.openai.com/v1
# Model used for the chat endpoint
OPENAI_CHAT_MODEL=gpt-5.4-mini

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
# Email address that receives lead notifications
NOTIFY_EMAIL=your_email@example.com
# Reply-to address for lead notification emails
SMTP_USER=your_reply_to@example.com
# Verified sender address — must be on a domain verified in your Resend dashboard.
# The sandbox default (onboarding@resend.dev) only delivers to the Resend account
# owner and will emit a warning in logs until replaced with a verified domain address.
NOTIFY_FROM=Corporate Academy <notifications@yourdomain.com>

# ─── Admin Authentication ─────────────────────────────────────────────────────
# Initial admin panel password. Log in at /admin with this password; the panel
# exchanges it for a 12-hour session token (x-admin-token header). Changing the
# password from the panel stores a hash in the database, which then takes over.
ADMIN_PASSWORD=change_me_to_a_strong_password

# ─── SEO ──────────────────────────────────────────────────────────────────────
# Public site origin used in /api/sitemap.xml <loc> URLs (no trailing slash).
SITE_ORIGIN=https://yourdomain.com

# ─── Cache / Session (not needed for API-only mode) ───────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
